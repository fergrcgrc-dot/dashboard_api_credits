# Copia este fichero a .env y rellena las claves. .env no se sube al repo.

# OpenRouter: una clave normal da saldo y límite; una "management key" añade el gasto por día.
OPENROUTER_API_KEY=

# fal.ai: clave de tipo ADMIN (las normales no leen facturación).
FAL_ADMIN_KEY=

# OpenAI: clave de administrador de la organización (sk-admin-...), no una clave de proyecto.
OPENAI_ADMIN_KEY=

# Opcionales
# PUERTO=8787
# UMBRAL_SALDO_BAJO=5
